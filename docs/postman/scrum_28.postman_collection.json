    {
      "name": "1. Organiser submits",
      "item": [
        {
          "name": "TC-01 Submit a complete request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiser_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{event_url}}/event-requests/submissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"Postman Charity Run\",\n  \"purpose\": \"Raise funds for the library\",\n  \"description\": \"A 5km community run with a breakfast afterwards.\",\n  \"proposed_date_times\": [\n    \"2026-11-14T08:00:00+08:00\"\n  ],\n  \"expected_attendance\": 120,\n  \"venue_requirements\": \"Park loop and start area\",\n  \"accessibility_needs\": \"Wheelchair-accessible route\",\n  \"equipment_requirements\": \"Water stations, PA system\",\n  \"registration_needs\": \"Online sign-up\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Request status is Submitted\", () => pm.expect(pm.response.json().status).to.eql(\"Submitted\"));",
                  "pm.collectionVariables.set(\"request_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02 Submission missing fields is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiser_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{event_url}}/event-requests/submissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"Incomplete\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 Organiser lists own requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiser_token}}"
              }
            ],
            "url": "{{event_url}}/event-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"List contains the request\", () => pm.expect(pm.response.json().map(r => r.id)).to.include(pm.collectionVariables.get(\"request_id\")));"
                ]
              }
            }
          ]
        }
      ]
    },
