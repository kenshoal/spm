{
  "info": {
    "name": "SCRUM-28 Track Event Status",
    "description": "Manual API tests for SCRUM-28 against the running Docker services. See README.md in this folder. Run folders in order; fill in the four accounts' emails and passwords in the collection variables first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup \u2014 log in all four accounts",
      "item": [
        {
          "name": "Log in as organiser",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{auth_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{organiser_email}}\",\n  \"password\": \"{{organiser_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"organiser_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
