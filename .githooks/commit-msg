#!/bin/sh

commit_message_file="$1"
subject=$(sed -n '1p' "$commit_message_file" | tr -d '\r')

# Conventional Commits: type, optional scope, optional breaking-change marker,
# followed by a non-empty description.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]_.-]+\))?!?: .+'
github_merge_pattern='^Merge pull request #[0-9]+ from [^[:space:]]+$'
git_merge_pattern="^Merge (remote-tracking )?branch '[^']+'( of [^[:space:]]+)? into [^[:space:]]+$"

if printf '%s\n' "$subject" | grep -Eq "$pattern|$github_merge_pattern|$git_merge_pattern"; then
    exit 0
fi

cat >&2 <<'EOF'
Invalid commit message.

Use the Conventional Commits format:
  <type>(optional-scope): <description>

Examples:
  feat: add user authentication
  fix(api): handle empty responses
  feat!: remove the legacy endpoint

Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
GitHub pull request merges and git's default merge messages are also allowed.
EOF

exit 1
