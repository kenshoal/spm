SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
AUTH_SERVICE_URL=http://127.0.0.1:8001

# Email (SCRUM-57). Leave SMTP_HOST empty and no email is sent; notifications
# still reach the inbox. For development use a sandbox such as Mailtrap
# (sandbox.smtp.mailtrap.io, port 2525). Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=SPM Notifications <no-reply@localhost>
INBOX_URL=http://localhost:3000/notifications
