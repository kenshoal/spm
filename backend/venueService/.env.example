# Read with os.getenv, not from this file: pass it via `uvicorn --env-file .env`
# or export it. Optional — defaults to http://127.0.0.1:8001.
AUTH_SERVICE_URL=http://127.0.0.1:8001

# Storage backend: "memory" (default; lost on restart) or "supabase".
VENUE_STORAGE_BACKEND=memory
# Required when VENUE_STORAGE_BACKEND=supabase. Server-only secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
