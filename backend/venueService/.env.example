# Copy to .env in this directory. Actual credentials must stay in the ignored .env.
# memory keeps all operations local; supabase uses the shared database.
VENUE_STORAGE_BACKEND=memory
VENUE_ENVIRONMENT=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Authentication is NOT implemented. Enable only for local development and bind
# the server to 127.0.0.1. Every write will be attributed to the configured user.
VENUE_ALLOW_STUB_AUTH=false
# Must reference an existing Supabase Authentication user. Do not generate an ID.
# VENUE_DEV_STAFF_USER_ID=replace-with-existing-test-user-uuid

# Future notification receiver endpoint. Leave unset for now.
# NOTIFICATION_SERVICE_URL=https://notifications.example.com/events
