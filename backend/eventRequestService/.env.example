SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
AUTH_SERVICE_URL=http://127.0.0.1:8001
# Optional: where notifications are sent. docker compose sets this to the
# notification service; leave unset to turn notifications off. It also starts
# the durable submission and arrangement-review notification relays.
# NOTIFICATION_SERVICE_URL=http://127.0.0.1:8005/notifications/events

# Opt in only after migration 0063 and the matching application are reviewed.
# This handler does not send notifications. The interval is finite and positive.
AUTO_COMPLETION_ENABLED=false
PERIODIC_TASK_INTERVAL_SECONDS=60
