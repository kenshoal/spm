# Supabase credentials — copy to .env and fill in (gitignored, do not commit).
# Fill in values from your Supabase project: Project Settings → API (Data API) and → Database.

# --- API (Project Settings → API) ---
# Not read by eventService's code yet (only DATABASE_URL is) — kept here so
# this file matches the shared team .env shape.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — client-side safe
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret key (sb_secret_...) — server-side only, never expose to the frontend
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Direct Postgres connection (Project Settings → Database → Connection string) ---
# Use the connection pooler (port 6543, "Transaction" mode, or 5432 "Session" mode)
# unless direct connections are enabled for your project (see backend/eventService/README.md).
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
