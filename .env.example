# Shared server-side configuration for Docker Compose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Optional SCRUM-40 worker: leave disabled until migration 0063 and the matching
# application are reviewed/deployed. Compose forwards these to eventRequestService.
AUTO_COMPLETION_ENABLED=false
PERIODIC_TASK_INTERVAL_SECONDS=60

# Optional SCRUM-38 registration opening/closing notices on the same timer. Off by
# default; needs NOTIFICATION_SERVICE_URL. A boundary older than the lookback is
# not announced late.
REGISTRATION_WINDOW_NOTICES_ENABLED=false
REGISTRATION_WINDOW_LOOKBACK_HOURS=72

# SCRUM-24 waiting-list timer and notices on the same timer: offers expire after
# 72 hours, and offers, warnings and expiries are delivered. Needs migration 0068.
WAITLIST_TIMERS_ENABLED=true

# Shared secret: only services holding it may post to notificationService. Compose
# falls back to a local-only value; set a long random one anywhere else.
NOTIFICATION_INTERNAL_TOKEN=
